
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
  engineType = "client"
}



model User {
  id Int @id @default(autoincrement())
  email String @unique
  name String
  password String 
  
}

