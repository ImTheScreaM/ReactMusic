datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "client"
}

enum ROLE {
  USER
  ADMIN
}

model User {
  id        Int         @id @default(autoincrement())
  email     String      @unique
  role      ROLE        @default(USER)
  loveMusic LoveMusic[]
  profile   Profile?
  name      String
  password  String
}

model Profile {
  id     Int     @id @default(autoincrement())
  bio    String?
  user   User    @relation(fields: [userId], references: [id])
  userId Int     @unique
}

model LoveMusic {
  id      Int      @id @default(autoincrement())
  userId  Int
  user    User     @relation(fields: [userId], references: [id])
  musicId Int
  music   Music    @relation(fields: [musicId], references: [id])
  addedAt DateTime @default(now())

  @@unique([userId, musicId])
}

model Music {
  id          Int         @id @default(autoincrement())
  name        String
  artist      String?
  genre       String?
  description String?
  time        Int?
  urlAvatar   String?
  lovedBy     LoveMusic[]
}
